<% url = settings[:url].to_s.strip %>
<% height = settings[:height].present? ? settings[:height].to_i : 485 %>
<% height = 485 unless height.between?(100, 3000) %>
<% if settings[:title].present? %>
  <h3><%= settings[:title] %></h3>
<% end %>
<% if url.present? %>
  <iframe src="<%= url %>"
          title="<%= settings[:title].presence || 'web window' %>"
          loading="lazy"
          style="width:100%;height:<%= height %>px;border:1px solid #c0c0c0;border-radius:3px;background:#fff"></iframe>
<% else %>
  <p class="hint"><%= l(:label_web_window_no_url) %></p>
<% end %>
